<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="magestack_integration_credential"
           resource="default"
           engine="innodb"
           comment="API Credentials Storage">
        <column xsi:type="int"
                name="credential_id"
                unsigned="true"
                nullable="false"
                identity="true"
                comment="Credential ID"/>
        <column xsi:type="varchar"
                name="api_code"
                nullable="false"
                length="64"
                comment="API Code"/>
        <column xsi:type="smallint"
                name="website_id"
                unsigned="true"
                nullable="false"
                default="0"
                comment="Website ID"/>
        <column xsi:type="varchar"
                name="auth_type"
                nullable="false"
                length="32"
                comment="Authentication Type"/>
        <column xsi:type="varchar"
                name="field_name"
                nullable="false"
                length="64"
                comment="Credential Field Name"/>
        <column xsi:type="text"
                name="field_value"
                nullable="false"
                comment="Encrypted Credential Value"/>
        <column xsi:type="timestamp"
                name="updated_at"
                on_update="true"
                nullable="false"
                default="CURRENT_TIMESTAMP"
                comment="Last Updated"/>
        <constraint xsi:type="primary"
                    referenceId="PRIMARY">
            <column name="credential_id"/>
        </constraint>
        <constraint xsi:type="unique"
                    referenceId="UNQ_MAGESTACK_INTEGRATION_CREDENTIAL">
            <column name="api_code"/>
            <column name="website_id"/>
            <column name="field_name"/>
        </constraint>
        <constraint xsi:type="foreign"
                    referenceId="FK_MAGESTACK_INTEGRATION_CREDENTIAL_WEBSITE"
                    table="magestack_integration_credential"
                    column="website_id"
                    referenceTable="store_website"
                    referenceColumn="website_id"
                    onDelete="CASCADE"/>
    </table>
    <table name="magestack_integration_api_attempt"
           resource="default"
           engine="innodb"
           comment="API Attempt Storage">
        <column xsi:type="int"
                name="attempt_id"
                unsigned="true"
                nullable="false"
                identity="true"
                comment="Attempt ID"/>
        <column xsi:type="varchar"
                name="api_code"
                nullable="false"
                length="64"
                comment="API Code"/>
        <column xsi:type="varchar"
                name="endpoint_code"
                nullable="false"
                length="64"
                comment="Endpoint Code"/>
        <column xsi:type="varchar"
                name="website_code"
                nullable="false"
                length="32"
                comment="Website Code"/>
        <column xsi:type="text"
                name="url_params"
                nullable="true"
                comment="URL Parameters"/>
        <column xsi:type="text"
                name="data"
                nullable="true"
                comment="input data"/>
        <column xsi:type="int"
                name="attempt"
                nullable="false"
                default="0"
                unsigned="true"
                comment="Retry Attempt"/>
        <column xsi:type="int"
                name="max_attempt"
                nullable="false"
                default="0"
                unsigned="true"
                comment="Max Retry Attempt"/>
        <column xsi:type="timestamp"
                name="next_attempt_at"
                nullable="true"
                comment="Next Attempt At"/>
        <column xsi:type="timestamp"
                name="created_at"
                on_update="false"
                nullable="false"
                default="CURRENT_TIMESTAMP"
                comment="Created At"/>
        <column xsi:type="timestamp"
                name="updated_at"
                on_update="true"
                nullable="false"
                default="CURRENT_TIMESTAMP"
                comment="Last Updated"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="attempt_id"/>
        </constraint>
    </table>
</schema>