<?xml version="1.0" encoding="UTF-8"?>
<apis>
    <api id="erp" enabled="true">
        <base_url>https://erp.company.com</base_url>
        <authentication type="bearer" token_endpoint="/admin/login" token_ttl="86400"/>
        <timeout>30</timeout>
        <retry enabled="true" max_attempts="3" initial_delay="1" backoff_multiplier="2">
            <http_code>429</http_code>
            <http_code>500</http_code>
            <http_code>502</http_code>
            <http_code>503</http_code>
            <http_code>504</http_code>
        </retry>
        <cache enabled="true" ttl="3600" key_prefix="erp_products"/>
        <endpoints>
            <endpoint id="get_user" method="GET" path="/users/{userId}" enabled="true">
                <cache enabled="false"/>
                <request_builder>
                    Vendor\Module\Model\RequestBuilder\UserRequestBuilder
                </request_builder>
            </endpoint>
            <endpoint id="get_products" method="GET" path="/products" enabled="true">
                <request_builder>
                    Vendor\Module\Model\RequestBuilder\ProductFilterBuilder
                </request_builder>
            </endpoint>
            <endpoint id="sync_inventory" method="POST" path="/inventory/sync" enabled="true" timeout="120">
                <retry max_attempts="5" initial_delay="5" backoff_multiplier="2"/>
                <request_builder>
                    Vendor\Module\Model\RequestBuilder\InventoryRequestBuilder
                </request_builder>
                <response_handler>
                    Vendor\Module\Model\Handler\InventoryHandler
                </response_handler>
                <response_validator>
                    Vendor\Module\Model\Validator\InventoryValidator
                </response_validator>
            </endpoint>
            <endpoint id="export_order" method="POST" path="/orders/export" enabled="true" >
                <retry enabled="false"/>
                <request_builder>
                    Vendor\Module\Model\RequestBuilder\OrderExportBuilder
                </request_builder>
                <response_handler>
                    Vendor\Module\Model\Handler\OrderExportHandler
                </response_handler>
            </endpoint>
        </endpoints>
        <websites>
            <website code="IN">
                <base_url>https://in-erp.company.com</base_url>
                <authentication token_endpoint="/admin/login/in" token_ttl="3600"/>
                <timeout>45</timeout> 
                <retry enabled="true" max_attempts="4">
                    <http_code>500</http_code>
                    <http_code>502</http_code>
                </retry>
                <endpoints>
                    <endpoint id="get_user" path="/in-users/{userId}">
                        <cache enabled="false"/>
                    </endpoint>
                    <endpoint id="get_products" path="/in-products">
                        <request_builder>
                            Vendor\Module\Model\RequestBuilder\V1\ProductFilterBuilder
                        </request_builder>
                    </endpoint>
                    <endpoint id="sync_inventory" path="/in-inventory/sync">
                        <response_validator>
                            Vendor\Module\Model\Validator\V1\InventoryValidator
                        </response_validator>
                    </endpoint>
                    <endpoint id="export_order" path="/in-orders/export">
                        <response_handler>
                            Vendor\Module\Model\Handler\V1\OrderExportHandler
                        </response_handler>
                    </endpoint>
                </endpoints>
            </website>
            <website code="US">
                <base_url>https://us-erp.company.com</base_url>
                <endpoints>
                    <endpoint id="get_user" path="/us-users/{userId}"/>
                    <endpoint id="sync_inventory" enabled="false"/>
                </endpoints>
            </website>
        </websites>
    </api>
</apis>
