<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
    <xs:element name="apis">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="api" type="apiType" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:simpleType name="httpMethodType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="GET"/>
            <xs:enumeration value="POST"/>
            <xs:enumeration value="PUT"/>
            <xs:enumeration value="PATCH"/>
            <xs:enumeration value="DELETE"/>
            <xs:enumeration value="HEAD"/>
            <xs:enumeration value="OPTIONS"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="configIdentifierType">
        <xs:restriction base="xs:string">
            <xs:maxLength value="64"/>
            <xs:pattern value="[a-z]([a-z0-9]*(_[a-z0-9]+)*)"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="httpStatusCodeType">
        <xs:restriction base="xs:positiveInteger">
            <xs:minInclusive value="100"/>
            <xs:maxInclusive value="599"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="positiveDecimalType">
        <xs:restriction base="xs:decimal">
            <xs:minExclusive value="0"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:complexType name="apiType">
        <xs:sequence>
            <xs:element name="title" type="xs:string"/>
            <xs:element name="base_url" type="xs:anyURI"/>
            <xs:element name="authentication" type="authenticationType" minOccurs="0"/>
            <xs:element name="timeout" type="xs:positiveInteger"/>
            <xs:element name="retry" type="retryType" minOccurs="0"/>
            <xs:element name="cache" type="cacheType" minOccurs="0"/>
            <xs:element name="endpoints" type="endpointsType" minOccurs="0"/>
            <xs:element name="websites" type="websitesType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="configIdentifierType" use="required"/>
        <xs:attribute name="enabled" type="xs:boolean" use="optional" default="true"/>
    </xs:complexType>
    <xs:complexType name="authenticationType">
        <xs:sequence>
            <xs:element name="type" type="configIdentifierType"/>
            <xs:element name="endpoint_id" type="configIdentifierType" minOccurs="0"/>
            <xs:element name="configuration" type="authenticationConfigurationType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="authenticationConfigurationType">
        <xs:sequence>
            <xs:element name="field" type="authenticationConfigurationFieldType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="authenticationConfigurationFieldType">
        <xs:attribute name="name" type="configIdentifierType" use="required"/>
        <xs:attribute name="label" type="xs:string" use="optional"/>
        <xs:attribute name="type" type="authenticationFieldInputType" use="optional" default="text"/>
        <xs:attribute name="encrypted" type="xs:boolean" use="optional" default="false"/>
        <xs:attribute name="class" type="xs:string" use="optional"/>
        <xs:attribute name="value" type="xs:string" use="optional"/>
    </xs:complexType>
    <xs:simpleType name="authenticationFieldInputType">
    <xs:restriction base="xs:string">
            <xs:enumeration value="text"/>
            <xs:enumeration value="password"/>
            <xs:enumeration value="textarea"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="retryType">
        <xs:sequence>
            <xs:element name="http_code" type="httpStatusCodeType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="enabled" type="xs:boolean" use="optional" default="false"/>
        <xs:attribute name="max_attempts" type="xs:positiveInteger" use="optional" default="3"/>
        <xs:attribute name="backoff_multiplier" type="positiveDecimalType" use="optional" default="2.0"/>
    </xs:complexType>
    <xs:complexType name="cacheType">
        <xs:attribute name="enabled" type="xs:boolean" use="optional" default="false"/>
        <xs:attribute name="ttl" type="xs:positiveInteger" use="optional" default="3600"/>
        <xs:attribute name="key_prefix" type="xs:string" use="optional"/>
    </xs:complexType>
    <xs:complexType name="endpointsType">
        <xs:sequence>
            <xs:element name="endpoint" type="endpointType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="endpointType">
        <xs:sequence>
            <xs:element name="cache" type="cacheType" minOccurs="0"/>
            <xs:element name="retry" type="retryType" minOccurs="0"/>
            <xs:element name="request_builder" type="xs:string" minOccurs="0"/>
            <xs:element name="response_handler" type="xs:string" minOccurs="0"/>
            <xs:element name="response_validator" type="xs:string" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="configIdentifierType" use="required"/>
        <xs:attribute name="path" type="xs:string" use="required"/>
        <xs:attribute name="guest" type="xs:boolean" use="optional" default="false"/>
        <xs:attribute name="method" type="httpMethodType" use="optional" default="GET"/>
        <xs:attribute name="enabled" type="xs:boolean" use="optional" default="true"/>
        <xs:attribute name="timeout" type="xs:positiveInteger" use="optional" default="30"/>
    </xs:complexType>
    <xs:complexType name="websitesType">
        <xs:sequence>
            <xs:element name="website" type="websiteType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="websiteType">
        <xs:sequence>
            <xs:element name="base_url" type="xs:anyURI" minOccurs="0"/>
            <xs:element name="authentication" type="authenticationType" minOccurs="0"/>
            <xs:element name="timeout" type="xs:positiveInteger" minOccurs="0"/>
            <xs:element name="retry" type="retryType" minOccurs="0"/>
            <xs:element name="cache" type="cacheType" minOccurs="0"/>
            <xs:element name="endpoints" type="endpointsType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="code" type="configIdentifierType" use="required"/>
    </xs:complexType>
</xs:schema>
