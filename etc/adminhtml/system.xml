<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="magestack_integration" translate="label" sortOrder="900" showInDefault="1" showInWebsite="1" showInStore="0">
            <label>MageStack Integration</label>
            <tab>mage</tab>
            <resource>MageStack_Integration::integration</resource>

            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            <!-- will add max attempt config value as a dropdown upto 1 - 5 -->
            <group id="cron" translate="label" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Cron</label>
                <field id="schedule" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Cron Schedule</label>
                    <comment>How often the retry cron job should run (overrides default)</comment>
                    <source_model>MageStack\Integration\Model\SystemConfig\Source\CronSchedule</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
